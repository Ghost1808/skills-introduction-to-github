# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Performance optimization: Cache and temporary directories #
############################################################
node_modules/
.npm/
.cache/
.parcel-cache/
.vscode/
.idea/
*.swp
*.swo
*~

# Build outputs and artifacts #
##############################
dist/
build/
out/
.next/
.nuxt/
target/

# Environment and configuration files #
######################################
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Performance: Large files that shouldn't be in git #
####################################################
*.mov
*.mp4
*.avi
*.wmv
*.webm
*.mkv
